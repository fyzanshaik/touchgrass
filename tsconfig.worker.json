{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "src/domain",
    "src/contracts",
    "src/worker",
    "tests/worker",
    "tests/worker-production",
    "tests/worker-unconfigured",
    "generated/worker-configuration.d.ts"
  ],
  "exclude": [
    "src/web",
    "tests/web"
  ]
}
